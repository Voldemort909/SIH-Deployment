# Local environment template. Copy to .env; never commit .env.
FLASK_ENV=development
FLASK_APP=backend.app:create_app
FLASK_RUN_PORT=5000

# Replace this with a long random value for production.
SECRET_KEY=replace-with-a-long-random-secret

# MySQL connection. On Render, fill in the MySQL private service credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=placement_db
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-password

# For the bundled frontend use *, or comma-separated origins for another host.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
