# Local environment template. Copy to .env; never commit .env.
FLASK_ENV=development
FLASK_APP=backend.app:create_app
FLASK_RUN_PORT=5000

# Replace this with a long random value for production.
SECRET_KEY=replace-with-a-long-random-secret

# Cloud SQL / Database connection URL
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://root:replace-with-your-mysql-password@127.0.0.1:3306/placement_db

# Demo seed user password (optional, used when running seed_sih_demo.py)
DEMO_USER_PASSWORD=DemoPassword123!

# For the bundled frontend use *, or comma-separated origins for another host.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

